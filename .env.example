# Blast Radius — configuration.
#
#   cp .env.example .env      (Windows: copy .env.example .env)
#   ...fill in the values below, then:
#   py setup_check.py         verifies every one of them against the real service
#   py server.py
#
# .env is gitignored. Real environment variables always win over this file, so
# a container that sets SUPABASE_URL its own way is not overridden.
# Everything here is optional: with an empty file the whole product still runs,
# using local password auth and in-app alerts only.


# ============================================================================
# 1 · SUPABASE  — put your project URL and anon key here
# ============================================================================
# Supabase dashboard → your project → Settings → API
#
#   Project URL   -> SUPABASE_URL
#   anon / public -> SUPABASE_ANON_KEY
#   service_role  -> SUPABASE_SERVICE_ROLE_KEY   (optional, see below)
#
# Set the first two and every sign-up and sign-in goes through Supabase Auth
# instead of this instance's local password store. Leave them blank and the
# local store is used — nothing else about the product changes either way.
#
# In Supabase → Authentication → Providers → Email, decide whether to require
# email confirmation. Both paths are handled: with confirmation on, sign-up
# tells the user to check their inbox and does not sign them in.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional. Only used to look an account up by id during administrative
# operations. Never sent to a browser. Leave blank if you would rather not
# have it on disk.
SUPABASE_SERVICE_ROLE_KEY=


# ============================================================================
# 2 · THIS DEPLOYMENT
# ============================================================================
# The origin users reach you on. Used in emails, webhook payloads and the
# copy-paste examples on /developers. Leave blank for local development and
# the request's own origin is used.
PUBLIC_URL=

# Set to 1 when served over HTTPS so the session cookie carries `Secure`.
SECURE_COOKIES=0


# ============================================================================
# 3 · ALERT DELIVERY  (24/7 monitoring)
# ============================================================================
# Alerts always land on the dashboard. These add delivery to the outside world
# so an alert reaches someone at 3am without a browser open.
#
# Webhooks need no configuration here — each account adds its own endpoint on
# the dashboard, and payloads are signed with a per-endpoint secret.
#
# Email needs an SMTP account. Any provider works; these are the usual shapes:
#   Gmail     smtp.gmail.com       587   (an App Password, not your password)
#   Postmark  smtp.postmarkapp.com 587
#   SES       email-smtp.<region>.amazonaws.com 587
#   Mailgun   smtp.mailgun.org     587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1


# ============================================================================
# 4 · THE WATCH
# ============================================================================
# How often the worker sweeps for monitors that are due, and how old a
# monitor's last check has to be before it is due again. The defaults measure
# every package roughly once an hour, around the clock.
MONITOR_INTERVAL=300
MONITOR_STALE=3600

# How long a webhook delivery may take before it is treated as failed.
WEBHOOK_TIMEOUT=10


# ============================================================================
# 5 · THE GRAPH  (usually leave alone)
# ============================================================================
HYDRA_URL=http://127.0.0.1:8443
HYDRA_TOKEN=local-development-token-32-bytes

# Requests per minute per IP for anonymous browser traffic. API calls made
# with a key are never rate limited.
RATE_LIMIT=600
